<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_goal_form_click_action" model="ir.ui.view">
        <field name="name">gamification.goal.form.click.action</field>
        <field name="model">gamification.goal</field>
        <field name="inherit_id" ref="gamification.goal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='computation_mode']" position="after">
                <field name="definition_action_id" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="get_action"
                    type="object"
                    string="Voir les enregistrements"
                    class="btn-secondary"
                    invisible="state == 'draft' or (not definition_action_id and computation_mode != 'manually')"
                />
            </xpath>
        </field>
    </record>
</odoo>
