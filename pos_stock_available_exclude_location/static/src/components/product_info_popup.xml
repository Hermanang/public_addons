<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock_available_exclude_location.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='props.info.productInfo.warehouses']/div" position="replace">
            <div class="d-flex flex-column flex-md-row gap-2">
                <div>
                    <t t-esc="warehouse.name" class="table-name"/>
                    :
                </div>
                <div>
                    <span class="me-1 fw-bolder"><t t-esc="warehouse.available_quantity" class="table-name"/></span>
                    <t t-esc="warehouse.uom"/> On Hand,
                </div>
                <div>
                    <span class="me-1 fw-bolder"><t t-esc="warehouse.immediately_usable_qty"/></span>
                    available,
                </div>
                <div>
                    <span class="me-1 fw-bolder"><t t-esc="warehouse.forecasted_quantity"/></span>
                    forecasted
                </div>
            </div>
        </xpath>
    </t>
</templates>
