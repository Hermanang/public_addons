<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_report_dynamic_column_profile_tree" model="ir.ui.view">
        <field name="name">report.dynamic.column.profile.tree</field>
        <field name="model">report.dynamic.column.profile</field>
        <field name="arch" type="xml">
            <list string="Profils de colonnes">
                <field name="name"/>
                <field name="report_type"/>
                <field name="is_default"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_report_dynamic_column_profile_form" model="ir.ui.view">
        <field name="name">report.dynamic.column.profile.form</field>
        <field name="model">report.dynamic.column.profile</field>
        <field name="arch" type="xml">
            <form string="Profil de colonnes">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_type"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Colonnes">
                        <field name="column_ids" nolabel="1" widget="many2many_tags"
                               domain="[('report_type', '=', report_type)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_report_dynamic_column_profile" model="ir.actions.act_window">
        <field name="name">Profils de colonnes</field>
        <field name="res_model">report.dynamic.column.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu sous Settings > Technique -->
    <menuitem
        id="menu_report_dynamic_column_profile"
        name="Profils de colonnes"
        parent="base.menu_custom"
        action="action_report_dynamic_column_profile"
        sequence="91"/>

</odoo>
