<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Record Rules OU pour le module Optique (bridge)
            ================================================
            Filtrage par unite operationnelle sur les modeles optical.*.
            Les utilisateurs avec operating_unit_access_all
            (= role Directeur ADR-4) voient automatiquement
            tous les enregistrements grace au mecanisme OCA.
        -->

        <!-- Record rule OU pour optical.policy -->
        <record id="optical_policy_rule_ou" model="ir.rule">
            <field name="name">Police optique : regle OU</field>
            <field name="model_id" ref="optical.model_optical_policy"/>
            <field name="domain_force">
                ['|', ('operating_unit_id', '=', False),
                      ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
        </record>

        <!-- Record rule OU pour optical.prescription -->
        <record id="optical_prescription_rule_ou" model="ir.rule">
            <field name="name">Ordonnance optique : regle OU</field>
            <field name="model_id" ref="optical.model_optical_prescription"/>
            <field name="domain_force">
                ['|', ('operating_unit_id', '=', False),
                      ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
        </record>

        <!-- Record rule OU pour optical.pec -->
        <record id="optical_pec_rule_ou" model="ir.rule">
            <field name="name">PEC optique : regle OU</field>
            <field name="model_id" ref="optical.model_optical_pec"/>
            <field name="domain_force">
                ['|', ('operating_unit_id', '=', False),
                      ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
        </record>

        <!-- Record rule OU pour optical.insurer.plan -->
        <record id="optical_insurer_plan_rule_ou" model="ir.rule">
            <field name="name">Plan de couverture : regle OU</field>
            <field name="model_id" ref="optical.model_optical_insurer_plan"/>
            <field name="domain_force">
                ['|', ('operating_unit_id', '=', False),
                      ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
        </record>

        <!--
            Regles access_all : les utilisateurs avec le groupe
            operating_unit_access_all voient TOUS les enregistrements
            quel que soit l'OU (role Directeur — ADR-4).
        -->

        <record id="optical_policy_rule_ou_access_all" model="ir.rule">
            <field name="name">Police optique : acces total OU</field>
            <field name="model_id" ref="optical.model_optical_policy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('operating_unit_access_all.group_all_operating_unit'))]"/>
        </record>

        <record id="optical_prescription_rule_ou_access_all" model="ir.rule">
            <field name="name">Ordonnance optique : acces total OU</field>
            <field name="model_id" ref="optical.model_optical_prescription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('operating_unit_access_all.group_all_operating_unit'))]"/>
        </record>

        <record id="optical_pec_rule_ou_access_all" model="ir.rule">
            <field name="name">PEC optique : acces total OU</field>
            <field name="model_id" ref="optical.model_optical_pec"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('operating_unit_access_all.group_all_operating_unit'))]"/>
        </record>

        <record id="optical_insurer_plan_rule_ou_access_all" model="ir.rule">
            <field name="name">Plan de couverture : acces total OU</field>
            <field name="model_id" ref="optical.model_optical_insurer_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('operating_unit_access_all.group_all_operating_unit'))]"/>
        </record>

    </data>
</odoo>
