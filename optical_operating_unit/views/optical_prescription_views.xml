<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search: ajout filtre group-by OU -->
    <record id="optical_prescription_view_search_ou" model="ir.ui.view">
        <field name="name">optical.prescription.search.ou</field>
        <field name="model">optical.prescription</field>
        <field name="inherit_id" ref="optical.optical_prescription_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_state']" position="after">
                <filter name="group_ou" string="Unite operationnelle"
                        context="{'group_by': 'operating_unit_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Tree: ajout colonne OU -->
    <record id="optical_prescription_view_tree_ou" model="ir.ui.view">
        <field name="name">optical.prescription.tree.ou</field>
        <field name="model">optical.prescription</field>
        <field name="inherit_id" ref="optical.optical_prescription_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="operating_unit_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Form: ajout champ OU -->
    <record id="optical_prescription_view_form_ou" model="ir.ui.view">
        <field name="name">optical.prescription.form.ou</field>
        <field name="model">optical.prescription</field>
        <field name="inherit_id" ref="optical.optical_prescription_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_expiry']" position="after">
                <field name="operating_unit_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

</odoo>
