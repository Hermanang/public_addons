<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard claim sheet: ajout champ OU -->
    <record id="optical_claim_sheet_wizard_form_ou" model="ir.ui.view">
        <field name="name">optical.claim.sheet.wizard.form.ou</field>
        <field name="model">optical.claim.sheet.wizard</field>
        <field name="inherit_id" ref="optical.optical_claim_sheet_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_to']" position="after">
                <field name="operating_unit_id"/>
            </xpath>
        </field>
    </record>

</odoo>
