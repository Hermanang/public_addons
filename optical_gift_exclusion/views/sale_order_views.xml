<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Colonne Cadeau dans les lignes de commande -->
    <record id="view_order_form_gift_column" model="ir.ui.view">
        <field name="name">sale.order.form.gift.column</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='price_total']" position="after">
                <field name="is_gift" widget="boolean_toggle" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
