<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_with_measures" inherit_id="sale.report_saleorder_document" primary="True">
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row">
                <div class="col-5">
                    <div class="row mb-4" id="informations-2">
                        <div t-if="doc.vision_type" class="col" name="informations_reference">
                            <strong>Type de vision</strong>
                            <div t-field="doc.vision_type">Vision de loin</div>
                        </div>
                    </div>
                    <div class="oe_structure">
                        <table class="table o_table table-bordered">
                            <thead>
                                <tr>
                                    <th/>
                                    <th>Sph</th>
                                    <th>Cyl</th>
                                    <th>Axe</th>
                                    <th>Add</th>
                                    <th>Prisme</th>
                                    <th>Base</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>OD</strong></td>
                                    <td><span t-field="doc.od_sphere"/></td>
                                    <td><span t-field="doc.od_cylinder"/></td>
                                    <td><span t-field="doc.od_axis"/></td>
                                    <td><span t-field="doc.od_addition"/></td>
                                    <td><span t-field="doc.od_prism"/></td>
                                    <td><span t-field="doc.od_base"/></td>
                                </tr>
                                <tr>
                                    <td><strong>OG</strong></td>
                                    <td><span t-field="doc.og_sphere"/></td>
                                    <td><span t-field="doc.og_cylinder"/></td>
                                    <td><span t-field="doc.og_axis"/></td>
                                    <td><span t-field="doc.og_addition"/></td>
                                    <td><span t-field="doc.og_prism"/></td>
                                    <td><span t-field="doc.og_base"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-5 offset-2"/>
            </div>
            <hr/>

        </xpath>
    </template>

    <template id="report_optical_assembly">
        <t t-call="web.external_layout">
            <style type="text/css">
            .o-opt-wrap{font-size:12px}
            .o-opt-title{font-weight:800;text-transform:uppercase;letter-spacing:.3px;margin:0}
            .o-opt-subtitle{font-weight:700;margin:0 0 6px 0}
            .o-opt-card{border:1px solid #000;border-radius:4px;padding:12px;margin-bottom:14px}
            .o-opt-kv .lbl{font-weight:700;white-space:nowrap}
            .o-opt-kv .val{padding-left:6px}
            .o-opt-row{display:flex;gap:16px;align-items:flex-start}
            .o-opt-col{flex:1}
            .o-opt-table{width:100%;border-collapse:collapse}
            .o-opt-table th,.o-opt-table td{border:1px solid #000;padding:4px 6px;vertical-align:middle}
            .o-opt-table th{text-align:center;font-weight:700}
            .o-opt-table td{text-align:center}
            .o-opt-table td:first-child{font-weight:700;text-align:left}
            .o-opt-totals{width:100%}
            .o-opt-totals td{padding:3px 6px}
            .o-opt-totals td:first-child{text-align:left}
            .o-opt-totals td:last-child{text-align:right}
            .o-opt-tight td{padding:2px 4px}
            .o-opt-small{font-size:11px}
            .o-opt-phone{font-weight:700}
            .o-opt-hr{border:0;border-top:2px solid #000;margin:10px 0}
          </style>
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <!-- ========= Variables fictives (PAS de getattr) ========= -->
            <t t-set="prompt_phone"          t-value="'Tél: +221    ___ ___   ___ ___ ___   ___ ___   ___ ___'"/>

            <!-- Récupérer toutes les lignes "montures" -->
            <t t-set="frame" t-value="doc.order_line.filtered(lambda l: (not l.display_type) and l.product_id.optical_product_type =='frames')"/>
            <!-- Récupérer toutes les lignes "verres" -->
            <t t-set="lens_lines" t-value="doc.order_line.filtered(lambda l: (not l.display_type) and l.product_id.optical_product_type =='lenses')"/>

            <div class="page o-opt-wrap">
                <!-- ====== REÇU ====== -->
                <div class="o-opt-topline">
                    <div class="o-opt-phone" t-esc="prompt_phone"/>
                    <h2 class="o-opt-title">Reçu</h2>
                </div>
                <div class="o-opt-card">
                    <!-- méta -->
                    <div class="row mb-4" id="informations">
                        <div t-if="doc.user_id.name" class="col">
                            <strong>Client(e)</strong>
                            <div t-field="doc.partner_id">Mitchell Admin</div>
                        </div>
                        <div class="col" name="informations_reference">
                            <strong>Numéro</strong>
                            <div t-field="doc.name">SO0000</div>
                        </div>
                        <div t-if="doc.date_order" class="col" name="informations_date">
                            <strong t-if="is_proforma">Date d'émission</strong>
                            <strong t-elif="doc.state in ['draft', 'sent']">Date devis</strong>
                            <strong t-else="">Date</strong>
                            <div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</div>
                        </div>
                        <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col" name="expiration_date">
                            <strong>Expiration</strong>
                            <div t-field="doc.validity_date">2023-12-31</div>
                        </div>
                        <div t-if="doc.user_id.name" class="col">
                            <strong>Vendeur</strong>
                            <div t-field="doc.user_id">Mitchell Admin</div>
                        </div>
                    </div>
                    <div class="o-opt-hr"></div>
                    <!-- produit -->
                    <div class="o-opt-row">
                        <div class="o-opt-col">
                            <div>
                                <span class="val">
                                    <t t-esc="frame.product_id.name.capitalize()"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <t t-if="lens_lines">
                        <div class="o-opt-row o-opt-small" style="margin-top:6px">
                            <t t-set="index" t-value="1"/>
                            <t t-foreach="lens_lines" t-as="l">
                                <t t-set="lens" t-value="(l.name or l.product_id.display_name or '').capitalize()"/>
                                <div t-if="index == 1" class="o-opt-col"><span class="lbl">OD : </span> <span class="val"><t t-esc="lens"/></span></div>
                                <div t-else="" class="o-opt-col"><span class="lbl">OG : </span> <span class="val"><t t-esc="opt_lens_og_ref"/></span></div>
                            </t>
                        </div>
                    </t>



                    <div class="o-opt-hr"></div>
                    <!-- mesures synthétiques -->
                    <table class="o-opt-table o-opt-tight o-opt-small" style="margin-top:6px">
                        <thead>
                            <tr>
                                <th style="width:8%"></th>
                                <th>Sph</th>
                                <th>Cyl</th>
                                <th>Axe</th>
                                <th>Add</th>
                                <th>Prisme</th>
                                <th>Base</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>OD</td>
                                <td><span t-field="doc.od_sphere"/></td>
                                <td><span t-field="doc.od_cylinder"/></td>
                                <td><span t-field="doc.od_axis"/></td>
                                <td><span t-field="doc.od_addition"/></td>
                                <td><span t-field="doc.od_prism"/></td>
                                <td><span t-field="doc.od_base"/></td>
                            </tr>
                            <tr>
                                <td>OG</td>
                                <td><span t-field="doc.og_sphere"/></td>
                                <td><span t-field="doc.og_cylinder"/></td>
                                <td><span t-field="doc.og_axis"/></td>
                                <td><span t-field="doc.og_addition"/></td>
                                <td><span t-field="doc.og_prism"/></td>
                                <td><span t-field="doc.og_base"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- totaux -->
                    <div class="o-opt-row" style="margin-top:8px">
                        <div class="o-opt-col"></div>
                        <div class="o-opt-col">
                            <table class="o-opt-totals o-opt-small">
                                <tr>
                                    <td><strong>Total TTC</strong></td>
                                    <td><span t-out="doc.amount_total" t-options='{"widget":"monetary","display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Avance</td>
                                    <td><span t-out="doc.currency_id.symbol"/></td>
                                </tr>
                                <tr>
                                    <td>Complément</td>
                                    <td><span t-out="doc.currency_id.symbol"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Reste</strong></td>
                                    <td><span t-out="doc.currency_id.symbol"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- ====== FICHE DE MONTAGE ====== -->
                <div class="o-opt-topline" style="margin-top:12px">
                    <div></div>
                    <h2 class="o-opt-title">Fiche de Montage</h2>
                </div>
                <div class="o-opt-card">
                    <!-- méta -->
                    <div class="row mb-4" id="informations">
                        <div t-if="doc.user_id.name" class="col">
                            <strong>Client(e)</strong>
                            <div t-field="doc.partner_id">Mitchell Admin</div>
                        </div>
                        <div class="col" name="informations_reference">
                            <strong>Numéro</strong>
                            <div t-field="doc.name">SO0000</div>
                        </div>
                        <div t-if="doc.date_order" class="col" name="informations_date">
                            <strong t-if="is_proforma">Date d'émission</strong>
                            <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                            <strong t-else="">Date</strong>
                            <div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</div>
                        </div>
                        <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col" name="expiration_date">
                            <strong>Expiration</strong>
                            <div t-field="doc.validity_date">2023-12-31</div>
                        </div>
                        <div t-if="doc.user_id.name" class="col">
                            <strong>Vendeur</strong>
                            <div t-field="doc.user_id">Mitchell Admin</div>
                        </div>
                    </div>
                    <div class="o-opt-hr"></div>
                    <!-- produit -->
                    <div class="o-opt-row">
                        <div class="o-opt-col">
                            <div>
                                <span class="val">
                                    <t t-esc="frame.product_id.name.capitalize()"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <t t-if="lens_lines">
                        <div class="o-opt-row o-opt-small" style="margin-top:6px">
                            <t t-set="index" t-value="1"/>
                            <t t-foreach="lens_lines" t-as="l">
                                <t t-set="lens" t-value="(l.name or l.product_id.display_name or '').capitalize()"/>
                                <div t-if="index == 1" class="o-opt-col"><span class="lbl">OD : </span> <span class="val"><t t-esc="lens"/></span></div>
                                <div t-else="" class="o-opt-col"><span class="lbl">OG : </span> <span class="val"><t t-esc="opt_lens_og_ref"/></span></div>
                            </t>
                        </div>
                    </t>
                    <div class="o-opt-hr"></div>
                    <!-- Mesure : -->
                    <div class="o-opt-subtitle">Mesure :</div>
                    <div class="o-opt-row ">
                        <div class="o-opt-col">
                            <span class="lbl">Type de vision : </span>
                            <!--<span class="val">-->
                            <!--	<t t-esc="vision_type"/>-->
                            <!--</span>-->
                            <span class="val" t-field="doc.prescription_id.vision_type">Vision de loin</span>
                        </div>
                        <div class="o-opt-col">
                            <span class="lbl">Date mesure : </span>
                            <!--<span class="val">-->
                            <!--	<t t-esc="measure_date"/>-->
                            <!--</span>-->
                            <span class="val" t-field="doc.prescription_id.measure_date">17/02/2025</span>
                        </div>
                        <div class="o-opt-col">
                            <span class="lbl">Type mesure : </span>
                            <!--<span class="val">-->
                            <!--	<t t-esc="measure_type"/>-->
                            <!--</span>-->
                            <span class="val" t-field="doc.prescription_id.measure_type">Verres</span>
                        </div>
                    </div>
                    <div class="o-opt-row" style="margin-top:6px">
                        <div class="o-opt-col">
                            <span class="lbl">EP OD : </span>
                            <span class="val">
                                <t t-esc="doc.prescription_id.ep_od"/>
                            </span>
                        </div>
                        <div class="o-opt-col">
                            <span class="lbl">EP OG : </span>
                            <span class="val">
                                <t t-esc="doc.prescription_id.ep_og"/>
                            </span>
                        </div>
                        <!--<div class="o-opt-col">-->
                        <!--	<span class="lbl">VP</span>-->
                        <!--	<span class="val">-->
                        <!--		<t t-esc="vp_label"/>-->
                        <!--	</span>-->
                        <!--</div>-->
                    </div>
                    <!-- tableau mesures -->
                    <div style="margin-top:8px">
                        <table class="o-opt-table o-opt-tight o-opt-small">
                            <thead>
                                <tr>
                                    <th style="width:8%"></th>
                                    <th>Sph</th>
                                    <th>Cyl</th>
                                    <th>Axe</th>
                                    <th>Add</th>
                                    <th>Prisme</th>
                                    <th>Base</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>OD</td>
                                    <td><span t-field="doc.od_sphere"/></td>
                                    <td><span t-field="doc.od_cylinder"/></td>
                                    <td><span t-field="doc.od_axis"/></td>
                                    <td><span t-field="doc.od_addition"/></td>
                                    <td><span t-field="doc.od_prism"/></td>
                                    <td><span t-field="doc.od_base"/></td>
                                </tr>
                                <tr>
                                    <td>OG</td>
                                    <td><span t-field="doc.og_sphere"/></td>
                                    <td><span t-field="doc.og_cylinder"/></td>
                                    <td><span t-field="doc.og_axis"/></td>
                                    <td><span t-field="doc.og_addition"/></td>
                                    <td><span t-field="doc.og_prism"/></td>
                                    <td><span t-field="doc.og_base"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- /o-opt-card -->
            </div>
            <!-- /page -->
        </t>
    </template>

    <template id="report_saleorder_document_optical">
        <t t-call="web.html_container">
            <t t-set="docs" t-value="docs.with_context(proforma=True)"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="otn_optical.report_saleorder_document_with_measures" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_saleorder_document_optical_receipt">
        <t t-call="web.html_container">
            <t t-set="docs" t-value="docs.with_context(proforma=True)"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="otn_optical.report_optical_assembly" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
