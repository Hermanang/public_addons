<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_saleorder_document_optical" model="ir.actions.report">
        <field name="name">Devis / Commande avec mesures</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">otn_optical.report_saleorder_document_optical</field>
        <field name="report_file">otn_optical.report_saleorder_document_optical</field>
        <field name="print_report_name">'Commande / Mesures - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Action de rapport -->
  <record id="action_report_optical_assembly" model="ir.actions.report">
      <field name="name">Fiche de Montage / Reçu</field>
      <field name="model">sale.order</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">otn_optical.report_saleorder_document_optical_receipt</field>
      <field name="report_file">otn_optical.report_saleorder_document_optical_receipt</field>
      <field name="print_report_name">'Fiche de montage - %s' % (object.name or '')</field>
      <field name="binding_model_id" ref="sale.model_sale_order"/>
      <field name="binding_type">report</field>
  </record>

</odoo>
