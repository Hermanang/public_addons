<?xml version="1.0"?>
<odoo>
    <!--
        product.lens.thickness views
    -->
    <record id="product_lens_thickness_view_form" model="ir.ui.view">
        <field name="name">product.lens.thickness.view.form</field>
        <field name="model">product.lens.thickness</field>
        <field name="arch" type="xml">
            <form string="Épaisseur de verre">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Aminci"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" required="True" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_lens_thickness_view_tree" model="ir.ui.view">
        <field name="name">product.lens.thickness.view.list</field>
        <field name="model">product.lens.thickness</field>
        <field name="arch" type="xml">
            <list string="Épaisseurs de verre" editable="bottom" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <!-- Épaisseur de verre Configuration -->
    <record id="product_lens_thickness_action" model="ir.actions.act_window">
        <field name="name">Épaisseur de verre</field>
        <field name="res_model">product.lens.thickness</field>
        <field name="view_id" ref="product_lens_thickness_view_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une épaisseur de verre</p>
        </field>
    </record>

    <menuitem
        name="Épaisseur de verre"
        id="menu_lens_thickness"
        action="product_lens_thickness_action"
        parent="sale.prod_config_main"
    />
</odoo>
