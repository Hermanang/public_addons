    <!-- Vue Search - Assurance -->
    <record id="view_optical_sale_insurance_report_search" model="ir.ui.view">
        <field name="name">report.optical.sale.insurance.search</field>
        <field name="model">report.optical.sale.insurance</field>
        <field name="arch" type="xml">
            <search string="Analyse par assurance">
                <field name="partner_id"/>
                <field name="insurance_id"/>
                <filter name="filter_with_insurance" string="Avec assurance" domain="[('insurance_id', '!=', False)]"/>
                <filter name="filter_no_insurance" string="Sans assurance" domain="[('insurance_id', '=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Date facture" date="invoice_date"/>
                <group expand="1" string="Grouper par">
                    <filter name="groupby_date" string="Date" context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="groupby_insurance" string="Assurance/IPM" context="{'group_by': 'insurance_id'}"/>
                    <filter name="groupby_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action - Assurance -->
    <record id="action_optical_sale_insurance_report" model="ir.actions.act_window">
        <field name="name">Analyse par assurance</field>
        <field name="res_model">report.optical.sale.insurance</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de données de ventes optiques
            </p>
            <p>
                Ce rapport analyse les ventes par assurance ou IPM du patient.
            </p>
        </field>
    </record>

