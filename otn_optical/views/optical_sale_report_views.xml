        <field name="name">report.optical.sale.insurance.list</field>
        <field name="model">report.optical.sale.insurance</field>
        <field name="arch" type="xml">
            <list string="Analyse par assurance" create="0" edit="0" delete="0">
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="insurance_id"/>
                <field name="quantity" sum="Total"/>
                <field name="price_subtotal" sum="Total CA HT"/>
