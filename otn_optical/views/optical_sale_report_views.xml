<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         RAPPORT PRODUIT - Analyse par propriétés produit
         ===================================================== -->

    <!-- Vue Pivot - Produit -->
    <record id="view_optical_sale_product_report_pivot" model="ir.ui.view">
        <field name="name">report.optical.sale.product.pivot</field>
        <field name="model">report.optical.sale.product</field>
        <field name="arch" type="xml">
            <pivot string="Analyse par produit" sample="1">
                <field name="invoice_date" type="row" interval="month"/>
                <field name="frame_shape" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vue Graph - Produit -->
    <record id="view_optical_sale_product_report_graph" model="ir.ui.view">
        <field name="name">report.optical.sale.product.graph</field>
        <field name="model">report.optical.sale.product</field>
        <field name="arch" type="xml">
            <graph string="Analyse par produit" type="bar" sample="1">
                <field name="frame_shape"/>
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vue Liste - Produit -->
    <record id="view_optical_sale_product_report_list" model="ir.ui.view">
        <field name="name">report.optical.sale.product.list</field>
        <field name="model">report.optical.sale.product</field>
        <field name="arch" type="xml">
            <list string="Analyse par produit" create="0" edit="0" delete="0">
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="optical_product_type"/>
                <field name="frame_shape"/>
                <field name="frame_gender"/>
                <field name="frame_rim_type"/>
                <field name="lens_material"/>
                <field name="quantity" sum="Total"/>
                <field name="price_subtotal" sum="Total CA HT"/>
                <field name="price_total" sum="Total CA TTC"/>
            </list>
        </field>
    </record>

    <!-- Vue Search - Produit -->
    <record id="view_optical_sale_product_report_search" model="ir.ui.view">
        <field name="name">report.optical.sale.product.search</field>
        <field name="model">report.optical.sale.product</field>
        <field name="arch" type="xml">
            <search string="Analyse par produit">
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="filter_montures" string="Montures" domain="[('optical_product_type', '=', 'frames')]"/>
                <filter name="filter_verres" string="Verres" domain="[('optical_product_type', '=', 'lenses')]"/>
                <filter name="filter_lentilles" string="Lentilles" domain="[('optical_product_type', '=', 'contact_lenses')]"/>
                <separator/>
                <filter name="filter_date" string="Date facture" date="invoice_date"/>
                <group expand="1" string="Grouper par">
                    <filter name="groupby_date" string="Date" context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="groupby_product_type" string="Type produit" context="{'group_by': 'optical_product_type'}"/>
                    <filter name="groupby_frame_shape" string="Forme monture" context="{'group_by': 'frame_shape'}"/>
                    <filter name="groupby_frame_gender" string="Genre" context="{'group_by': 'frame_gender'}"/>
                    <filter name="groupby_frame_rim" string="Type cercle" context="{'group_by': 'frame_rim_type'}"/>
                    <filter name="groupby_lens_material" string="Matière verre" context="{'group_by': 'lens_material'}"/>
                    <filter name="groupby_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Filtres prédéfinis - Produit -->
    <record id="filter_optical_product_by_shape" model="ir.filters">
        <field name="name">Par forme de monture</field>
        <field name="model_id">report.optical.sale.product</field>
        <field name="domain">[('optical_product_type', '=', 'frames')]</field>
        <field name="context">{'group_by': ['frame_shape']}</field>
        <field name="is_default">False</field>
    </record>

    <record id="filter_optical_product_this_month" model="ir.filters">
        <field name="name">Montures ce mois</field>
        <field name="model_id">report.optical.sale.product</field>
        <field name="domain">[('optical_product_type', '=', 'frames')]</field>
        <field name="context">{'group_by': ['frame_shape']}</field>
        <field name="is_default">False</field>
    </record>

    <!-- Action - Produit -->
    <record id="action_optical_sale_product_report" model="ir.actions.act_window">
        <field name="name">Analyse par produit</field>
        <field name="res_model">report.optical.sale.product</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas de données de ventes optiques
            </p>
            <p>
                Ce rapport analyse les ventes par propriétés des produits optiques
                (forme, matière, genre des montures).
            </p>
        </field>
    </record>

    <!-- =====================================================
