    <!-- =====================================================
         MENUS
         ===================================================== -->

    <!-- Menu parent Analyse Optique sous Ventes > Analyse -->
    <menuitem
        id="menu_optical_analysis"
        name="Analyse Optique"
        parent="sale.menu_sale_report"
        sequence="30"
        groups="sales_team.group_sale_salesman"/>

    <!-- Sous-menus -->
    <menuitem
        id="menu_optical_analysis_product"
        name="Par produit"
        parent="menu_optical_analysis"
        action="action_optical_sale_product_report"
        sequence="10"/>

    <menuitem
        id="menu_optical_analysis_insurance"
        name="Par assurance"
        parent="menu_optical_analysis"
        action="action_optical_sale_insurance_report"
        sequence="20"/>

    <menuitem
        id="menu_optical_analysis_prescriber"
        name="Par prescripteur"
        parent="menu_optical_analysis"
        action="action_optical_sale_prescriber_report"
        sequence="30"/>

    <menuitem
        id="menu_optical_analysis_subscriber"
        name="Par souscripteur"
        parent="menu_optical_analysis"
        action="action_optical_sale_subscriber_report"
        sequence="40"/>

</odoo>
