<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="measures" string="Mesures" invisible="optical_product_type == 'others'">
                    <group>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Sphère</th>
                                    <th>Cylindre</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>OD</strong></td>
                                    <td><field name="od_sphere" widget="char"/></td>
                                    <td><field name="od_cylinder" widget="char"/></td>
                                </tr>
                                <tr>
                                    <td><strong>OG</strong></td>
                                    <td><field name="og_sphere" widget="char"/></td>
                                    <td><field name="og_cylinder" widget="char"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="optical_product_type"/>
            </xpath>
        </field>
    </record>

    <record id="product_frames_action_sell" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="path">frames</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="view_id" ref="product.product_template_kanban_view"/>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="domain">[("optical_product_type", "=", "frames")]</field>
        <field name="context">{
            "search_default_filter_to_sell":1,
            "sale_multi_pricelist_product_template": 1,
            "default_optical_product_type": "frames"
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p><p>
                You must define a product for everything you sell or purchase,
                whether it's a storable product, a consumable or a service.
            </p>
        </field>
    </record>

    <record id="product_glasses_action_sell" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="path">glasses</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="view_id" ref="product.product_template_kanban_view"/>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="domain">[("optical_product_type", "=", "glasses")]</field>
        <field name="context">{
            "search_default_filter_to_sell":1,
            "sale_multi_pricelist_product_template": 1,
            "default_optical_product_type": "frames"
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p><p>
                You must define a product for everything you sell or purchase,
                whether it's a storable product, a consumable or a service.
            </p>
        </field>
    </record>

    <menuitem id="sale.menu_product_template_action"
        name="Autres"
        action="sale.product_template_action"
        parent="sale.product_menu_catalog"
        sequence="21"/>
    <menuitem id="menu_products_frames"
        name="Montures"
        action="product_frames_action_sell"
        parent="sale.product_menu_catalog"
        sequence="20"/>
    <menuitem id="menu_products_glasses"
        name="Verres"
        action="product_glasses_action_sell"
        parent="sale.product_menu_catalog"
        sequence="20"/>
</odoo>