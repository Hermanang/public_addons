<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Type de relation: est employé de (Patient → Entreprise souscriptrice) -->
    <record id="relation_type_employee" model="res.partner.relation.type">
        <field name="name">est employé de</field>
        <field name="name_inverse">emploie</field>
        <field name="contact_type_left">p</field>
        <field name="contact_type_right">c</field>
    </record>

    <!-- Type de relation: exerce dans (Médecin → Cabinet/Clinique) -->
    <record id="relation_type_works_at" model="res.partner.relation.type">
        <field name="name">exerce dans</field>
        <field name="name_inverse">emploie (médical)</field>
        <field name="contact_type_left">p</field>
        <field name="contact_type_right">c</field>
        <field name="partner_category_right" ref="partner_category_clinical"/>
    </record>

</odoo>
