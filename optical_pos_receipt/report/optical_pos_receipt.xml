<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Action d'impression : Reçu de caisse sur sale.order             -->
    <!-- ============================================================== -->
    <record id="action_report_optical_pos_receipt" model="ir.actions.report">
        <field name="name">Reçu de caisse</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">optical_pos_receipt.report_optical_pos_receipt</field>
        <field name="report_file">optical_pos_receipt.report_optical_pos_receipt</field>
        <field name="print_report_name">'Reçu - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_optical_pos_receipt"/>
    </record>

    <!-- ============================================================== -->
    <!-- Wrapper                                                         -->
    <!-- ============================================================== -->
    <template id="report_optical_pos_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="optical_pos_receipt.report_optical_pos_receipt_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- ============================================================== -->
    <!-- Helper : tableau de mesures SPH / CYL / AXE / ADD / PRISME / BASE -->
    <!-- ============================================================== -->
    <template id="report_optical_pos_receipt_measures">
        <t t-set="presc" t-value="doc.prescription_id"/>
        <table class="lo-rcpt-measures">
            <thead>
                <tr>
                    <th></th>
                    <th>SPH</th>
                    <th>CYL</th>
                    <th>AXE</th>
                    <th>ADD</th>
                    <th>PRI</th>
                    <th>BAS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>OD</td>
                    <td><span t-if="presc" t-field="presc.od_sphere"/></td>
                    <td><span t-if="presc" t-field="presc.od_cylinder"/></td>
                    <td><span t-if="presc" t-field="presc.od_axis"/></td>
                    <td><span t-if="presc" t-field="presc.od_addition"/></td>
                    <td><span t-if="presc" t-field="presc.od_prism"/></td>
                    <td><span t-if="presc" t-field="presc.od_prism_base"/></td>
                </tr>
                <tr>
                    <td>OG</td>
                    <td><span t-if="presc" t-field="presc.og_sphere"/></td>
                    <td><span t-if="presc" t-field="presc.og_cylinder"/></td>
                    <td><span t-if="presc" t-field="presc.og_axis"/></td>
                    <td><span t-if="presc" t-field="presc.og_addition"/></td>
                    <td><span t-if="presc" t-field="presc.og_prism"/></td>
                    <td><span t-if="presc" t-field="presc.og_prism_base"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- ============================================================== -->
    <!-- Document principal : un reçu par sale.order (style POS)         -->
    <!-- ============================================================== -->
    <template id="report_optical_pos_receipt_document">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="presc" t-value="doc.prescription_id"/>

        <!-- Lignes monture/verres : achetées vs offertes -->
        <t t-set="frame_paid"
           t-value="doc.order_line.filtered(lambda l: not l.display_type and l.product_id.optical_type == 'frame' and not l.is_gift)"/>
        <t t-set="lens_paid"
           t-value="doc.order_line.filtered(lambda l: not l.display_type and l.product_id.optical_type == 'lens' and not l.is_gift)"/>
        <t t-set="frame_gift"
           t-value="doc.order_line.filtered(lambda l: not l.display_type and l.product_id.optical_type == 'frame' and l.is_gift)"/>
        <t t-set="lens_gift"
           t-value="doc.order_line.filtered(lambda l: not l.display_type and l.product_id.optical_type == 'lens' and l.is_gift)"/>

        <!-- Boutique : warehouse_id en priorité, sinon operating_unit_id, sinon team_id -->
        <t t-set="boutique_label"
           t-value="(doc.warehouse_id.name if doc.warehouse_id else (doc.operating_unit_id.name if 'operating_unit_id' in doc._fields and doc.operating_unit_id else (doc.team_id.name if doc.team_id else '')))"/>

        <!-- Partenaire boutique : source d'adresse/tél/email pour l'entête et footer.
             On prend warehouse.partner_id si dispo, sinon fallback company.partner_id.
             Prérequis : chaque warehouse doit avoir son propre partner avec adresse renseignée. -->
        <t t-set="boutique_partner"
           t-value="doc.warehouse_id.partner_id if (doc.warehouse_id and doc.warehouse_id.partner_id) else doc.company_id.partner_id"/>

        <!-- Total à payer par le client : ticket modérateur si assurance, sinon total complet.
             amount_patient est mis à 0 par optical si pas de policy_id, on fallback sur amount_total. -->
        <t t-set="total_due" t-value="doc.amount_patient if doc.has_insurance else doc.amount_total"/>

        <!-- Acompte = somme des paiements reçus sur factures patient liées
             (exclut les factures envoyées à l'assureur via is_insurance_invoice) -->
        <t t-set="paid_amount"
           t-value="sum((inv.amount_total - inv.amount_residual) for inv in doc.invoice_ids if inv.state == 'posted' and inv.move_type == 'out_invoice' and not inv.is_insurance_invoice)"/>
        <t t-set="remaining" t-value="total_due - paid_amount"/>

        <div class="page lo-rcpt">
            <style>
                /* === Reset largeur ticket POS === */
                .lo-rcpt {
                    font-family: 'Courier New', 'Liberation Mono', Courier, monospace;
                    font-size: 10pt;
                    color: #000;
                    line-height: 1.35;
                    width: 100%;
                }

                /* === Header logo + société === */
                .lo-rcpt-logo {
                    text-align: center;
                    margin: 2px 0 6px 0;
                }
                .lo-rcpt-logo img {
                    max-height: 80px;
                    max-width: 90%;
                    display: inline-block;
                }
                .lo-rcpt-company {
                    text-align: center;
                    font-size: 9pt;
                    line-height: 1.3;
                    margin-bottom: 4px;
                }
                .lo-rcpt-company .name {
                    font-weight: bold;
                    font-size: 10pt;
                }

                /* === Lignes pointillées style POS (texte) === */
                .lo-rcpt-dash {
                    text-align: center;
                    font-size: 10pt;
                    letter-spacing: 0;
                    margin: 3px 0;
                    white-space: nowrap;
                    overflow: hidden;
                    line-height: 1;
                }

                /* === Titre principal === */
                .lo-rcpt-title {
                    text-align: center;
                    font-weight: bold;
                    font-size: 13pt;
                    margin: 4px 0 2px 0;
                    letter-spacing: 1px;
                }
                .lo-rcpt-subtitle {
                    text-align: center;
                    font-size: 10pt;
                    margin-bottom: 2px;
                }

                /* === Section titre (MONTURE ACHETEE / OFFERTE) === */
                .lo-rcpt-section {
                    text-align: center;
                    font-weight: bold;
                    font-size: 10pt;
                    margin: 5px 0 3px 0;
                    letter-spacing: 0.5px;
                }

                /* === Lignes info "label : value" === */
                .lo-rcpt-line {
                    font-size: 9pt;
                    margin: 1px 0;
                    line-height: 1.3;
                    word-break: break-word;
                }
                .lo-rcpt-line .lbl {
                    font-weight: bold;
                }

                /* === Tableau mesures optiques === */
                .lo-rcpt-measures {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 8pt;
                    margin: 4px 0;
                    font-family: 'Courier New', Courier, monospace;
                }
                .lo-rcpt-measures th,
                .lo-rcpt-measures td {
                    border: 1px solid #000;
                    padding: 2px 1px;
                    text-align: center;
                }
                .lo-rcpt-measures th { font-weight: bold; }
                .lo-rcpt-measures td:first-child,
                .lo-rcpt-measures th:first-child {
                    font-weight: bold;
                    width: 12%;
                }

                /* === Totaux : tableau 2 colonnes label / montant === */
                .lo-rcpt-totals {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 4px 0;
                    font-size: 10pt;
                }
                .lo-rcpt-totals td {
                    padding: 2px 0;
                    vertical-align: top;
                }
                .lo-rcpt-totals .lbl { text-align: left; }
                .lo-rcpt-totals .amt { text-align: right; white-space: nowrap; }
                .lo-rcpt-total-big td {
                    font-size: 12pt;
                    font-weight: bold;
                    padding-top: 4px;
                }

                /* === Footer style POS === */
                .lo-rcpt-footer {
                    text-align: center;
                    font-size: 9pt;
                    margin-top: 8px;
                    line-height: 1.5;
                }
                .lo-rcpt-footer .phone {
                    font-weight: bold;
                    font-size: 10pt;
                }
                .lo-rcpt-footer .thanks {
                    font-style: italic;
                    margin-top: 3px;
                }

                /* === Méta fin de ticket : N° + date (style POS) === */
                .lo-rcpt-meta {
                    text-align: center;
                    font-size: 8pt;
                    margin-top: 10px;
                    line-height: 1.4;
                }
            </style>

            <!-- ====================================================== -->
            <!-- LOGO + société (style POS ReceiptHeader)                -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-logo">
                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
            </div>
            <div class="lo-rcpt-company">
                <div class="name" t-if="boutique_partner.name" t-out="boutique_partner.name"/>
                <div t-if="boutique_partner.street" t-out="boutique_partner.street"/>
                <div t-if="boutique_partner.street2" t-out="boutique_partner.street2"/>
                <div>
                    <t t-out="boutique_partner.city or ''"/>
                    <t t-if="boutique_partner.country_id"> / <t t-out="boutique_partner.country_id.name"/></t>
                </div>
                <div t-if="boutique_partner.phone">Tél : <t t-out="boutique_partner.phone"/></div>
                <div t-if="boutique_partner.email" t-out="boutique_partner.email"/>
            </div>

            <div class="lo-rcpt-dash">================================</div>

            <!-- ====================================================== -->
            <!-- Titre RECU DE CAISSE                                    -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-title">REÇU DE CAISSE</div>
            <div class="lo-rcpt-subtitle">
                Dossier N° : <strong t-out="doc.name or ''"/>
            </div>

            <div class="lo-rcpt-dash">--------------------------------</div>

            <!-- ====================================================== -->
            <!-- Bloc infos client / commande                            -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-line">
                <span class="lbl">Client : </span>
                <t t-out="doc.partner_id.name or ''"/>
            </div>
            <div class="lo-rcpt-line" t-if="doc.partner_id.phone or doc.partner_id.mobile">
                <span class="lbl">Tél client : </span>
                <t t-out="doc.partner_id.phone or doc.partner_id.mobile"/>
            </div>
            <div class="lo-rcpt-line" t-if="doc.date_order">
                <span class="lbl">Date commande : </span>
                <t t-out="doc.date_order.strftime('%d/%m/%Y')"/>
            </div>
            <div class="lo-rcpt-line" t-if="doc.commitment_date">
                <span class="lbl">Date livraison : </span>
                <t t-out="doc.commitment_date.strftime('%d/%m/%Y')"/>
            </div>
            <div class="lo-rcpt-line" t-if="doc.user_id">
                <span class="lbl">Commercial(e) : </span>
                <t t-out="doc.user_id.name"/>
            </div>
            <div class="lo-rcpt-line" t-if="boutique_label">
                <span class="lbl">Boutique : </span>
                <t t-out="boutique_label"/>
            </div>

            <div class="lo-rcpt-dash">--------------------------------</div>

            <!-- ====================================================== -->
            <!-- MONTURE ACHETÉE                                         -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-section">MONTURE ACHETÉE</div>
            <div class="lo-rcpt-line" t-if="frame_paid">
                <span class="lbl">Monture : </span>
                <t t-out="frame_paid[:1].product_id.display_name or ''"/>
            </div>
            <div class="lo-rcpt-line">
                <span class="lbl">Type de verres : </span>
                <t t-if="doc.prescription_vision_type">
                    <span t-field="doc.prescription_vision_type"/>
                </t>
                <t t-else="" t-out="lens_paid[:1].product_id.display_name or ''"/>
            </div>
            <div class="lo-rcpt-line" t-if="lens_paid and lens_paid[:1].product_id.lens_treatment_ids">
                <span class="lbl">Traitement : </span>
                <t t-out="', '.join(lens_paid[:1].product_id.lens_treatment_ids.mapped('name'))"/>
            </div>
            <t t-call="optical_pos_receipt.report_optical_pos_receipt_measures"/>

            <!-- ====================================================== -->
            <!-- MONTURE OFFERTE (si lignes is_gift)                     -->
            <!-- ====================================================== -->
            <t t-if="frame_gift or lens_gift">
                <div class="lo-rcpt-dash">--------------------------------</div>
                <div class="lo-rcpt-section">MONTURE OFFERTE</div>
                <div class="lo-rcpt-line" t-if="frame_gift">
                    <span class="lbl">Monture : </span>
                    <t t-out="frame_gift[:1].product_id.display_name or ''"/>
                </div>
                <div class="lo-rcpt-line" t-if="lens_gift">
                    <span class="lbl">Type de verres : </span>
                    <t t-out="lens_gift[:1].product_id.display_name or ''"/>
                </div>
                <div class="lo-rcpt-line" t-if="lens_gift and lens_gift[:1].product_id.lens_treatment_ids">
                    <span class="lbl">Traitement : </span>
                    <t t-out="', '.join(lens_gift[:1].product_id.lens_treatment_ids.mapped('name'))"/>
                </div>
                <!-- Même ordonnance partagée -->
                <t t-call="optical_pos_receipt.report_optical_pos_receipt_measures"/>
            </t>

            <div class="lo-rcpt-dash">================================</div>

            <!-- ====================================================== -->
            <!-- Totaux                                                  -->
            <!-- ====================================================== -->
            <table class="lo-rcpt-totals">
                <tr class="lo-rcpt-total-big">
                    <td class="lbl">TOTAL TTC</td>
                    <td class="amt">
                        <span t-out="total_due"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="lbl">Acompte</td>
                    <td class="amt">
                        <span t-out="paid_amount"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="lo-rcpt-total-big">
                    <td class="lbl">RESTE À PAYER</td>
                    <td class="amt">
                        <span t-out="remaining"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div class="lo-rcpt-dash">================================</div>

            <!-- ====================================================== -->
            <!-- Footer message                                          -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-footer">
                <div class="phone" t-if="boutique_partner.phone">
                    Tél : <t t-out="boutique_partner.phone"/>
                </div>
                <div class="thanks">Merci de votre confiance !</div>
                <div>Conservez ce reçu pour le retrait de vos lunettes.</div>
            </div>

            <!-- ====================================================== -->
            <!-- Footer méta style POS : N° de commande + date           -->
            <!-- ====================================================== -->
            <div class="lo-rcpt-meta">
                <div t-out="doc.name or ''"/>
                <div t-if="doc.date_order"
                     t-out="doc.date_order.strftime('%d/%m/%Y %H:%M')"/>
            </div>
        </div>
    </template>

</odoo>
