<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_complaint_motive_search" model="ir.ui.view">
        <field name="name">helpdesk.complaint.motive.search</field>
        <field name="model">helpdesk.complaint.motive</field>
        <field name="arch" type="xml">
            <search string="Recherche motif">
                <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="view_helpdesk_complaint_motive_list" model="ir.ui.view">
        <field name="name">helpdesk.complaint.motive.list</field>
        <field name="model">helpdesk.complaint.motive</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_complaint_motive_form" model="ir.ui.view">
        <field name="name">helpdesk.complaint.motive.form</field>
        <field name="model">helpdesk.complaint.motive</field>
        <field name="arch" type="xml">
            <form string="Motif de réclamation">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" required="1" placeholder="ex: Verre rayé"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_complaint_motive" model="ir.actions.act_window">
        <field name="name">Motifs de réclamation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">helpdesk.complaint.motive</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Définissez les motifs de réclamation
            </p>
            <p>
                Liste de motifs structurés (multi-cochables) à associer aux tickets
                de type Réclamation. Les motifs peuvent être combinés sur un même
                ticket (ex: une chute peut entraîner Branches cassées + Pont cassé +
                Verre rayé).
            </p>
        </field>
    </record>

    <menuitem
        id="menu_helpdesk_complaint_motive"
        name="Motifs réclamation"
        parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
        action="action_helpdesk_complaint_motive"
        sequence="35"/>

</odoo>
