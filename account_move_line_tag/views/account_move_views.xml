<odoo>

    <record id="view_move_form_inherit_add_tag" model="ir.ui.view">
        <field name="name">account.move.form.add.tags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                position="after"
            >
                <field
                    name="tag_ids"
                    options="{'no_create': True, 'no_create_edit':True}"
                    context="{'create': False}"
                    widget="many2many_tags"
                />
            </xpath>
        </field>
    </record>

    <record id="account_move_line_tag_view_tree" model="ir.ui.view">
        <field name="name">account.move.line.tag.tree</field>
        <field name="model">account.move.line.tag</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="account_move_line_tag_action" model="ir.actions.act_window">
        <field name="name">Account Move Line Tags</field>
        <field name="res_model">account.move.line.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="account_move_line_tag_action_menu"
        name="Account Move Line Tags"
        parent="account.account_invoicing_menu"
        action="account_move_line_tag_action"
        sequence="20"
    />

</odoo>
