<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Record Rules multi-boutique — Story 15.0 (archi V1.1 § 8.3)
            =============================================================
            Sur optical.followup.schedule et optical.followup.schedule.line :
              - user  : voit uniquement les calendriers des boutiques auxquelles
                        il est rattaché via res.users.optical_warehouse_ids
              - manager : accès global (aucune restriction)
        -->

        <!-- Schedule : commercial restrictif (unlink=False pour rester cohérent avec l'ACL user) -->
        <record id="schedule_user_warehouse_rule" model="ir.rule">
            <field name="name">Calendriers de fidélisation : boutiques rattachées</field>
            <field name="model_id" ref="model_optical_followup_schedule"/>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                [('warehouse_id', 'in', user.optical_warehouse_ids.ids)]
            </field>
        </record>

        <!-- Schedule : responsable global -->
        <record id="schedule_manager_global_rule" model="ir.rule">
            <field name="name">Calendriers de fidélisation : accès global responsable</field>
            <field name="model_id" ref="model_optical_followup_schedule"/>
            <field name="groups" eval="[(4, ref('optical.group_optical_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Schedule.line : commercial restrictif (via schedule_id.warehouse_id) -->
        <record id="schedule_line_user_warehouse_rule" model="ir.rule">
            <field name="name">Étapes de calendrier : boutiques rattachées</field>
            <field name="model_id" ref="model_optical_followup_schedule_line"/>
            <field name="groups" eval="[(4, ref('optical.group_optical_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                [('schedule_id.warehouse_id', 'in', user.optical_warehouse_ids.ids)]
            </field>
        </record>

        <!-- Schedule.line : responsable global -->
        <record id="schedule_line_manager_global_rule" model="ir.rule">
            <field name="name">Étapes de calendrier : accès global responsable</field>
            <field name="model_id" ref="model_optical_followup_schedule_line"/>
            <field name="groups" eval="[(4, ref('optical.group_optical_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
