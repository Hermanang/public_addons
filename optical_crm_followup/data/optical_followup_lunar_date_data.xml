        <!--
            Table lunaire hégirienne 2026-2030 — 20 records (4 événements × 5 années).

            Sources :
              - Ramadan / Aïd al-Fitr / Aïd al-Adha : MoonSighting.com (dates
                astronomiques) — à valider annuellement par l'atelier PO
                avant chaque Ramadan (audit `verified` P3 rétro 15 § 6.6).
              - Grand Magal de Touba : Comité Khalifal (Sénégal).

            ⚠️ Ces dates sont des approximations à la rédaction (juillet 2026).
            Le PO doit les confirmer annuellement (chantier maintenance).
            Précision requise NFR-13 : ± 1 jour.

            noupdate="1" — les responsables peuvent corriger post-install.
        -->

        <!-- ============================= 2026 ============================= -->

        <record id="lunar_date_ramadan_2026" model="optical.followup.lunar.date">
            <field name="name">Ramadan 2026</field>
            <field name="year">2026</field>
            <field name="event">ramadan_start</field>
            <field name="date_gregorian_start" eval="'2026-02-18'"/>
            <field name="date_gregorian_end" eval="'2026-03-19'"/>
            <field name="source">MoonSighting.com — approximation, à valider PO</field>
            <field name="verified">True</field>
        </record>

