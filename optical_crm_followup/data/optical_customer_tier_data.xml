<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Tiers clients par défaut (Story 18-1 — refonte VIP configurable).

            Ces 2 records reproduisent la taxonomie figée de la V1 (Story 17-1 :
            Selection standard/vip) sous forme de données éditables. XML IDs
            stables (tier_standard / tier_vip) pour ré-ancrer les références
            data (plan_vip_extra.tier_id) et la migration des partners.

            IMPORTANT : le tier PAR DÉFAUT (tier_standard) doit être chargé EN
            PREMIER — la contrainte _check_single_default refuse un tier actif
            alors qu'aucun défaut n'existe encore.

            noupdate="1" : un responsable peut ensuite renommer, ré-ordonner ou
            ajuster le seuil de ces tiers sans qu'un upgrade module n'écrase ses
            réglages. Le seuil de tier_vip livré ici (500 000 FCFA) est le
            défaut historique ; la migration post-*.py le remplace par la valeur
            réelle du paramètre système V1 le cas échéant (AC-6.1).
        -->

        <record id="tier_standard" model="optical.customer.tier">
            <field name="name">Standard</field>
            <field name="code">standard</field>
            <field name="sequence">10</field>
            <field name="threshold_fcfa">0.0</field>
            <field name="is_default">True</field>
            <field name="color">0</field>
        </record>

        <record id="tier_vip" model="optical.customer.tier">
            <field name="name">VIP</field>
            <field name="code">vip</field>
            <field name="sequence">100</field>
            <field name="threshold_fcfa">500000.0</field>
            <field name="is_default">False</field>
            <field name="color">4</field>
        </record>

    </data>
</odoo>
