<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="optical.OpticalDiopterField">
        <span t-if="props.readonly" t-esc="displayValue"/>
        <input
            t-else=""
            t-on-focusin="onFocusIn"
            t-on-focusout="onFocusOut"
            t-on-keydown="onKeyDown"
            t-att-id="props.id"
            t-ref="numpadDecimal"
            t-att-placeholder="props.placeholder"
            type="text"
            inputmode="decimal"
            class="o_input"
            autocomplete="off"
            t-att-step="step"/>
    </t>
</templates>
