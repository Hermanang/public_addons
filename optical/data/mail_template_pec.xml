<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_pec_request" model="mail.template">
            <field name="name">Demande de PEC</field>
            <field name="model_id" ref="model_optical_pec"/>
            <field name="subject">Demande de prise en charge {{ object.name }} - {{ object.patient_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
            <field name="partner_to">{{ object.insurer_id.id }}</field>
            <field name="description">Email de demande de prise en charge envoyé à l'assureur/IPM</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Bonjour,</p>

    <p>Nous vous prions de recevoir la demande de prise en charge de <t t-out="object.patient_id.name or ''">Nom Patient</t>.</p>

    <p>Veuillez trouver en pièce jointe la facture proforma, la police, et l'ordonnance.</p>

    <p>N'hésitez pas à nous contacter pour toute information complémentaire.</p>

    <p>Cordialement,</p>
    --<br/><p>
        <t t-out="object.company_id.name or ''">Votre société</t><br/>
        <t t-if="object.company_id.phone"><t t-out="object.company_id.phone"/><br/></t>
        <t t-if="object.company_id.email"><t t-out="object.company_id.email"/></t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
