<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_expire_prescriptions" model="ir.cron">
            <field name="name">Optique : Expiration automatique des ordonnances</field>
            <field name="model_id" ref="model_optical_prescription"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_prescriptions()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
        </record>
        <record id="ir_cron_expire_policies" model="ir.cron">
            <field name="name">Optique : Expiration automatique des polices</field>
            <field name="model_id" ref="model_optical_policy"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_policies()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
        </record>
    </data>
</odoo>
