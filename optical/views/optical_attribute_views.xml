<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Traitement de verre (optical.lens.treatment)                 -->
    <!-- ============================================================ -->

    <record id="optical_lens_treatment_view_list" model="ir.ui.view">
        <field name="name">optical.lens.treatment.list</field>
        <field name="model">optical.lens.treatment</field>
        <field name="arch" type="xml">
            <list string="Traitements verres" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="optical_lens_treatment_view_form" model="ir.ui.view">
        <field name="name">optical.lens.treatment.form</field>
        <field name="model">optical.lens.treatment</field>
        <field name="arch" type="xml">
            <form string="Traitement verre">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du traitement"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="optical_lens_treatment_action" model="ir.actions.act_window">
        <field name="name">Traitements verres</field>
        <field name="res_model">optical.lens.treatment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un traitement de verre
            </p>
        </field>
    </record>

