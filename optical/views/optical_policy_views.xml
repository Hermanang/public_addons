<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue recherche -->
    <record id="optical_policy_view_search" model="ir.ui.view">
        <field name="name">optical.policy.search</field>
        <field name="model">optical.policy</field>
        <field name="arch" type="xml">
            <search string="Polices d'assurance">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurer_id"/>
                <field name="subscriber_id"/>
                <separator/>
                <filter name="filter_active" string="Actives"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expirés"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_cancelled" string="Annulées"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_insurer" string="Assureur"
                        context="{'group_by': 'insurer_id'}"/>
                <filter name="filter_subscriber" string="Souscripteur"
                        context="{'group_by': 'subscriber_id'}"/>
                <filter name="filter_patient" string="Patient"
                        context="{'group_by': 'patient_id'}"/>
                <filter name="filter_relationship" string="Relation bénéficiaire"
                        context="{'group_by': 'beneficiary_relationship'}"/>
            </search>
        </field>
    </record>

    <!-- Vue liste -->
    <record id="optical_policy_view_tree" model="ir.ui.view">
        <field name="name">optical.policy.tree</field>
        <field name="model">optical.policy</field>
        <field name="arch" type="xml">
            <list string="Polices d'assurance">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurer_id"/>
                <field name="subscriber_id" optional="show"/>
                <field name="coverage_rate"/>
                <field name="amount_consumed" optional="hide"/>
                <field name="amount_remaining" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state == 'cancelled'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="optical_policy_view_form" model="ir.ui.view">
        <field name="name">optical.policy.form</field>
        <field name="model">optical.policy</field>
        <field name="arch" type="xml">
            <form string="Police d'assurance">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations principales">
                            <field name="patient_id"/>
                            <field name="subscriber_id"/>
                            <field name="beneficiary_relationship"/>
                            <field name="member_number"/>
                            <field name="insurer_id"/>
                            <field name="plan_id"/>
                            <field name="coverage_rate"/>
                        </group>
                        <group string="Validité et société">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Consommation" invisible="not plan_id">
                        <group>
                            <field name="annual_cap_total" readonly="1"/>
                            <field name="amount_consumed" readonly="1"/>
                            <field name="amount_remaining" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action window -->
    <record id="optical_policy_action" model="ir.actions.act_window">
        <field name="name">Polices d'assurance</field>
        <field name="res_model">optical.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="optical_policy_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une police d'assurance
            </p>
            <p>
                Gérez les cartes d'assurance des patients avec leur taux de couverture.
            </p>
        </field>
    </record>

</odoo>
