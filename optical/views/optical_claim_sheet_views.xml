<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         BORDEREAUX MENSUELS - Vues consultation (Story 8-3)
         ===================================================== -->

    <!-- Tree view -->
    <record id="view_optical_claim_sheet_list" model="ir.ui.view">
        <field name="name">optical.claim.sheet.list</field>
        <field name="model">optical.claim.sheet</field>
        <field name="arch" type="xml">
            <list string="Bordereaux" create="0" edit="0" delete="0">
                <field name="name" string="Reference"/>
                <field name="state" string="Etat"
                       widget="badge"
                       decoration-success="state == 'generated'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="insurer_id" string="Assureur / IPM"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_generated"/>
                <field name="invoice_count" string="Factures"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="amount_paid" string="Recu" optional="show"/>
                <field name="amount_residual" string="Reste" optional="show"/>
                <field name="is_fully_paid" string="Paye"
                       widget="boolean"
                       decoration-success="is_fully_paid"
                       decoration-danger="not is_fully_paid"/>
                <field name="type" optional="hide"/>
                <field name="user_id" string="Genere par" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_optical_claim_sheet_form" model="ir.ui.view">
        <field name="name">optical.claim.sheet.form</field>
        <field name="model">optical.claim.sheet</field>
        <field name="arch" type="xml">
            <form string="Bordereau" create="0" edit="0" delete="0">
                <header>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            confirm="Êtes-vous sûr de vouloir annuler ce bordereau ? Les factures seront libérées."
                            invisible="state != 'generated' or amount_paid &gt; 0"
                            groups="optical.group_optical_manager"/>
                    <button name="%(optical.action_report_claim_sheet)d"
                            string="Imprimer"
                            type="action"
                            class="btn-primary"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="insurer_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="type"/>
                            <field name="parent_id" invisible="type == 'normal'"/>
                        </group>
                        <group string="Totaux">
                            <field name="invoice_count"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                            <field name="is_fully_paid"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Generation">
                        <field name="date_generated"/>
                        <field name="user_id"/>
                    </group>
                    <notebook>
                        <page string="Factures" name="invoices">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name" string="Reference"/>
                                    <field name="partner_id" string="Assureur"/>
                                    <field name="pec_id" optional="show"/>
                                    <field name="pec_partner_ref" string="Réf. organisme" optional="show"/>
                                    <field name="patient_name" string="Beneficiaire"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total_signed" string="Montant" sum="Total"/>
                                    <field name="payment_state" string="Paiement"
                                           widget="badge"
                                           decoration-info="payment_state == 'not_paid'"
                                           decoration-success="payment_state == 'paid'"
                                           decoration-warning="payment_state == 'partial'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_optical_claim_sheet_search" model="ir.ui.view">
        <field name="name">optical.claim.sheet.search</field>
        <field name="model">optical.claim.sheet</field>
        <field name="arch" type="xml">
            <search string="Bordereaux">
                <field name="name" string="Reference"/>
                <field name="insurer_id" string="Assureur / IPM"/>
                <separator/>
                <filter name="filter_active" string="Actifs (non annulés)"
                        domain="[('state', '!=', 'cancelled')]"/>
                <filter name="filter_cancelled" string="Annulés"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_normal" string="Normal"
                        domain="[('type', '=', 'normal')]"/>
                <filter name="filter_complementary" string="Complementaire"
                        domain="[('type', '=', 'complementary')]"/>
                <filter name="filter_rectificative" string="Rectificatif"
                        domain="[('type', '=', 'rectificative')]"/>
                <separator/>
                <filter name="filter_fully_paid" string="Entierement payes"
                        domain="[('is_fully_paid', '=', True)]"/>
                <filter name="filter_not_fully_paid" string="Reste a recevoir"
                        domain="[('is_fully_paid', '=', False)]"/>
                <separator/>
                <group expand="1" string="Grouper par">
                    <filter name="groupby_insurer" string="Assureur / IPM"
                            context="{'group_by': 'insurer_id'}"/>
                    <filter name="groupby_period" string="Periode"
                            context="{'group_by': 'date_from:month'}"/>
                    <filter name="groupby_type" string="Type"
                            context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_optical_claim_sheet" model="ir.actions.act_window">
        <field name="name">Bordereaux</field>
        <field name="res_model">optical.claim.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_optical_claim_sheet_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun bordereau genere
            </p>
            <p>
                Les bordereaux sont generes depuis le menu "Generer Bordereau".
            </p>
        </field>
    </record>

</odoo>
