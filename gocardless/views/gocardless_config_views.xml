<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue arbre pour les configurations GoCardless -->
    <record id="view_gocardless_config_tree" model="ir.ui.view">
        <field name="name">gocardless.config.tree</field>
        <field name="model">gocardless.config</field>
        <field name="arch" type="xml">
            <list string="GoCardless Configurations">
                <field name="display_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_active"/>
                <field name="gc_environment"/>
                <field name="gc_access_token" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire pour les configurations GoCardless -->
    <record id="view_gocardless_config_form" model="ir.ui.view">
        <field name="name">gocardless.config.form</field>
        <field name="model">gocardless.config</field>
        <field name="arch" type="xml">
            <form string="GoCardless Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="gc_environment"/>
                            <field name="gc_access_token" password="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Credentials">
                            <group>
                                <group>
                                    <field name="gc_client_id"/>
                                    <field name="gc_client_secret" password="True"/>
                                </group>
                                <group>
                                    <field name="gc_description"/>
                                    <field name="gc_webhook_secret" password="True"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="gc_redirect_uri" readonly="1" placeholder="URL will be generated after saving"/>
                                </group>
                            </group>
                        </page>

                        <page string="Settings">
                            <group>
                                <group>
                                    <field name="gc_custom_domain"/>
                                    <field name="gc_keep_journal"/>
                                </group>
                                <group>
                                    <field name="gc_journal_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Test Connection">
                            <div class="alert alert-info">
                                <p>Test the connection to GoCardless with the current credentials.</p>
                            </div>
                            <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                            
                            <div class="mt16">
                                <h3>OAuth Connection</h3>
                                <button class="oe_highlight" 
                                        invisible="gc_access_token not in ['', False, None]" 
                                        name="gocardless_connect" 
                                        string="Connect to GoCardless" 
                                        type="object"/>
                                <button invisible="gc_access_token in ['', False, None]" 
                                        name="gocardless_connect" 
                                        string="Reconnect to GoCardless" 
                                        type="object"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Recherche pour les configurations GoCardless -->
    <record id="view_gocardless_config_search" model="ir.ui.view">
        <field name="name">gocardless.config.search</field>
        <field name="model">gocardless.config</field>
        <field name="arch" type="xml">
            <search string="GoCardless Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_active"/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Actions pour les configurations GoCardless -->
    <record id="action_gocardless_config" model="ir.actions.act_window">
        <field name="name">GoCardless Configurations</field>
        <field name="path">gocardless-accounts</field>
        <field name="res_model">gocardless.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gocardless_config_tree"/>
        <field name="search_view_id" ref="view_gocardless_config_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new GoCardless Configuration
            </p>
            <p>
                Configure GoCardless settings for each company.
            </p>
        </field>
    </record>

    <!-- Menu pour les configurations GoCardless -->
    <menuitem id="menu_gocardless_config" 
              name="GoCardless Configurations" 
              parent="account.menu_finance"
              action="action_gocardless_config"
              sequence="100"/>
</odoo>
